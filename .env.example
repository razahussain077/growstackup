# ── Supabase (lead storage) ───────────────────────────────────────────────
# From Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key   # server-only, keep secret

# ── Email alerts on new lead (optional, Phase 3) ──────────────────────────
# From https://resend.com → API Keys
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=you@growstackup.com
# RESEND_FROM defaults to "GrowStackUp <onboarding@resend.dev>" until you verify a domain
RESEND_FROM=

# ── Search engine verification (optional) ─────────────────────────────────
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
